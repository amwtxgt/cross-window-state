{
  "name": "cross-window-state",
  "version": "0.1.2",
  "description": "One state, many windows, always in sync — shared reactive state for Electron multi-window apps and cross-tab web apps, with built-in persistence and versioned migration.",
  "keywords": [
    "broadcast-channel",
    "cross-tab",
    "cross-window",
    "electron",
    "electron-state",
    "ipc",
    "multi-window",
    "shared-state",
    "state-management",
    "vue"
  ],
  "homepage": "https://amwtxgt.github.io/cross-window-state/",
  "bugs": "https://github.com/amwtxgt/cross-window-state/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amwtxgt/cross-window-state.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./main": {
      "import": {
        "types": "./dist/main/index.d.mts",
        "default": "./dist/main/index.mjs"
      },
      "require": {
        "types": "./dist/main/index.d.cts",
        "default": "./dist/main/index.cjs"
      }
    },
    "./preload": {
      "types": "./dist/preload/index.d.cts",
      "default": "./dist/preload/index.cjs"
    },
    "./renderer": {
      "import": {
        "types": "./dist/renderer/index.d.mts",
        "default": "./dist/renderer/index.mjs"
      },
      "require": {
        "types": "./dist/renderer/index.d.cts",
        "default": "./dist/renderer/index.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue/index.d.mts",
        "default": "./dist/vue/index.mjs"
      },
      "require": {
        "types": "./dist/vue/index.d.cts",
        "default": "./dist/vue/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "example:basic": "pnpm build && pnpm --filter cross-window-state-example-basic dev",
    "example:basic:web": "pnpm build && pnpm --filter cross-window-state-example-basic build:web && pnpm --filter cross-window-state-example-basic preview",
    "example:notes": "pnpm build && pnpm --filter cross-window-state-example-notes dev",
    "example:notes:web": "pnpm build && pnpm --filter cross-window-state-example-notes build:web && pnpm --filter cross-window-state-example-notes preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && pnpm --filter cross-window-state-example-basic build && playwright test -c test/e2e/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check .",
    "format": "oxfmt",
    "publint": "publint",
    "attw": "attw --pack --profile node16",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "5.0.0-rc.2",
    "electron": "^44.0.0",
    "happy-dom": "^20.11.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "publint": "^0.3.24",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vite": "^8.2.2",
    "vitepress": "^1.6.4",
    "vitest": "5.0.0-rc.2",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "electron": ">=28",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "vue": {
      "optional": true,
      "inject": false
    }
  },
  "engines": {
    "node": ">=22"
  }
}
