{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-underscore-dangle": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/require-post-message-target-origin": "off"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "coverage",
    "docs",
    "examples",
    "test-results",
    "playwright-report"
  ]
}
